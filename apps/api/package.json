{
  "name": "@hakimi/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts",
    "schema:verify": "tsx src/schema-verify.ts",
    "docs:validate": "npx redocly lint openapi.yaml",
    "test:integration:db": "vitest run --config vitest.integration.config.ts",
    "worker:reminders": "tsx src/reminders/worker.ts"
  },
  "dependencies": {
    "express": "^5.0.0",
    "dotenv": "^17.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.9",
    "vitest": "^3.0.0"
  }
}
