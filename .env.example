# Development-only example values
PORT=3001
NODE_ENV=development
POSTGRES_DB=hakimi_dev
POSTGRES_USER=hakimi_dev
POSTGRES_PASSWORD=change-me-development-only
DATABASE_URL=postgresql://hakimi_dev:change-me-development-only@127.0.0.1:5432/hakimi_dev
WEB_API_BASE_URL=http://localhost:3001
LOG_LEVEL=info
OIDC_ISSUER=https://identity.example/realms/hakimi-workforce
OIDC_AUDIENCE=hakimi-api
OIDC_JWKS_URI=https://identity.example/realms/hakimi-workforce/protocol/openid-connect/certs
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_REQUIRED_ACR_VALUES=workforce-mfa
OIDC_CLOCK_TOLERANCE_SECONDS=30

# Optional local OIDC provider for host-run API development only.
# Start it with: docker compose --profile local-oidc up -d oidc
# Then override the API OIDC values in your private .env only when running the
# API on the host, not inside the production-shaped Compose api service.
# OIDC_ISSUER=http://localhost:8080/realms/hakimi-local
# OIDC_JWKS_URI=http://localhost:8080/realms/hakimi-local/protocol/openid-connect/certs
# LOCAL_OIDC_PORT=8080
# LOCAL_OIDC_ADMIN_USERNAME=hakimi-local-admin
# LOCAL_OIDC_ADMIN_PASSWORD=change-me-local-admin-only
# HAKIMI_ENABLE_LOCAL_DEMO_PROVISIONING=false
# VITE_OIDC_ISSUER=http://localhost:8080/realms/hakimi-local
# VITE_OIDC_CLIENT_ID=hakimi-web
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# VITE_OIDC_SCOPE=openid
# VITE_HAKIMI_API_BASE_URL=/api/v1
REMINDER_WORKER_ID=reminder-worker-dev
REMINDER_POLL_INTERVAL_MS=1000
REMINDER_BATCH_SIZE=25
REMINDER_LEASE_MS=120000
REMINDER_MAX_ATTEMPTS=5
REMINDER_BACKOFF_BASE_MS=60000
REMINDER_BACKOFF_CAP_MS=3600000
