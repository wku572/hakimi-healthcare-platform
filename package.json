{
  "name": "hakimi-healthcare-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev --workspace @hakimi/web\" \"npm run dev --workspace @hakimi/api\"",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run migrate --workspace @hakimi/api -- up",
    "db:migrate:down": "npm run migrate --workspace @hakimi/api -- down",
    "db:migrate:status": "npm run migrate --workspace @hakimi/api -- status",
    "db:schema:verify": "npm run schema:verify --workspace @hakimi/api",
    "test:integration:db": "npm run test:integration:db --workspace @hakimi/api",
    "api:docs:validate": "npm run docs:validate --workspace @hakimi/api",
    "worker:reminders": "npm run worker:reminders --workspace @hakimi/api",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@redocly/cli": "^2.34.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.9.0"
  }
}
